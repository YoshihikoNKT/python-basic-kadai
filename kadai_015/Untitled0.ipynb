      "source": [
        "class Human:\n",
        "    def __init__(self, name, age):\n",
        "        self.name = name\n",
        "        self.age = age\n",
        "\n",
        "    def printinfo(self):\n",
        "        print(f\"名前: {self.name}\")\n",
        "        print(f\"年齢: {self.age}\")\n",
        "\n",
        "\n",
        "# Humanクラスのインスタンスを生成して変数に代入\n",
        "human1 = Human(\"山田太郎\", 25)\n",
        "human1.printinfo()"
      ]
    }
  ]
}